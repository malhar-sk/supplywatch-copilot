# Copy to .env  (cp .env.example .env). Never commit .env.

# --- LLM (optional but recommended) ---
# With a key, /ask and /agent use Claude via the API. Without one the API
# falls back to an extractive answer (top retrieved sentences, no LLM).
ANTHROPIC_API_KEY=
# auto | anthropic | claude_cli | fake | none
LLM_BACKEND=auto
ANSWER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# --- Retrieval ---
RETRIEVAL_MODE=hybrid
REFUSAL_MIN_SIMILARITY=0.60

# --- Auth ---
JWT_SECRET=
JWT_TTL_SECONDS=900
# Needed to create OAuth clients with the `admin` scope.
ADMIN_BOOTSTRAP_SECRET=

# --- Webhooks / n8n ---
# Shared HMAC secret: the API signs with it, the n8n workflow verifies with it.
WEBHOOK_SIGNING_SECRET=
# Optional: if both set, n8n also sends a Telegram message; otherwise it logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Resend e-mail alerts (logged, not sent, when empty)
RESEND_API_KEY=

# --- Host ports (change if something already uses them) ---
API_HOST_PORT=18000
DB_HOST_PORT=15432
N8N_HOST_PORT=15678

# Source-pipeline scheduler hits live yfinance/Google News; off by default.
ENABLE_SCHEDULER=false
